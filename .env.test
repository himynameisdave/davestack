# Playwright env: TEST_MODE captures auth email in memory. No DATABASE_URL on purpose:
# `bun run test:e2e` injects a throwaway Postgres per run, and CI injects its service container.
NODE_ENV="test"
TEST_MODE="1"

BETTER_AUTH_SECRET="test-secret-not-for-production"
BETTER_AUTH_URL="http://localhost:4173"
