# Test environment — committed to the repo (no real secrets).
# Loaded by playwright.config.ts. There is deliberately NO DATABASE_URL here:
# `bun run test:e2e` (scripts/test-e2e.ts) starts a throwaway Postgres container
# per run and injects its URL; CI injects its postgres service. So e2e can never
# touch dev data. TEST_MODE enables the in-memory mailbox used to assert
# verification / magic-link flows.
NODE_ENV="test"
TEST_MODE="1"

BETTER_AUTH_SECRET="test-secret-not-for-production"
# Must match the Playwright preview server origin (adapter-node preview = 4173).
BETTER_AUTH_URL="http://localhost:4173"
