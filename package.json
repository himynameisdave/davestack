{
  "name": "davestack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && prisma generate && vite build",
    "check": "svelte-kit sync && prisma generate && svelte-check-rs --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && prisma generate && svelte-check-rs --tsconfig ./tsconfig.json --watch",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "svelte-kit sync && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "dev": "svelte-kit sync && prisma generate && vite dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.config.ts --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint -c oxlint.config.ts --fix --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "prepare": "husky",
    "preview": "vite preview",
    "setup": "bun scripts/setup.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.29",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.29",
    "pg": "^8.22.0",
    "resend": "^6.18.1",
    "sveltekit-rate-limiter": "^0.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@himynameisdave/oxfmt-config": "~1.0.0",
    "@himynameisdave/oxlint-config": "~1.1.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.24.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^7.8.0",
    "svelte": "^5.56.9",
    "svelte-check-rs": "^0.11.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,svelte,css,html,json,yaml,yml,md}": "oxfmt --write",
    "*.{ts,js,svelte}": "oxlint -c oxlint.config.ts --deny-warnings",
    "*": "bun scripts/check-staged.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
