{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"],
  // The service worker is its own TS project (src/service-worker/tsconfig.json).
  "exclude": ["src/service-worker"]
}
